{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://jglftdstrowwckwqmpue.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/:slug/hours",
      "destination": "https://jglftdstrowwckwqmpue.supabase.co/functions/v1/confirm-hours?slug=:slug"
    },
    {
      "source": "/confirm-hours",
      "destination": "https://jglftdstrowwckwqmpue.supabase.co/functions/v1/confirm-hours"
    },
    {
      "source": "/booking-action",
      "destination": "https://jglftdstrowwckwqmpue.supabase.co/functions/v1/booking-action"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
